{
  "extends": ["@nlabrazi/config-biome/configs/recommended"],
  "files": {
    "includes": [
      "!**/*.css",
      "!**/*.svg",
      "!**/*.html",
      "!api/dist",
      "!api/coverage",
      "!public/assets",
      "!data"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  }
}
